  1: <script>
  2:   import { onDestroy, tick } from 'svelte';
  3:   import questionsData from './questions.json';
  4: 
  5:   const MAX_LIVES = 3;
  6:   const QUESTION_TIME_LIMIT = 10;
  7:   const totalQuestions = questionsData.length;
  8: 
  9:   // Game state
 10:   let lives = MAX_LIVES;
 11:   let remainingQuestions = [...questionsData];
 12:   let currentQuestion = null;
 13:   let userAnswer = '';
 14:   let feedbackMessage = '';
 15:   let feedbackStatus = ''; // 'correct' | 'wrong' | ''
 16:   let gameState = 'idle'; // 'idle' | 'playing' | 'won' | 'lost'
 17:   let correctCount = 0;
 18:   let incorrectCount = 0;
 19:   let inputField;
 20: 
 21:   // Timer state
 22:   let timeLeft = QUESTION_TIME_LIMIT;
 23:   let timerId = null;
 24: 
 25:   // Reactive counts
 26:   $: completedCount = totalQuestions - remainingQuestions.length;
 27:   $: attemptedCount = correctCount + incorrectCount;
 28: 
 29:   // Pick a random question object from the given array
 30:   function getRandomQuestion(questionList) {
 31:     if (questionList.length === 0) {
 32:       return null;
 33:     }
 34:     const randomIndex = Math.floor(Math.random() * questionList.length);
 35:     return questionList[randomIndex];
 36:   }
 37: 
 38:   // Stop any running countdown interval
 39:   function stopTimer() {
 40:     if (timerId !== null) {
 41:       clearInterval(timerId);
 42:       timerId = null;
 43:     }
 44:   }
 45: 
 46:   // Start or reset the 10-second countdown for the active question
 47:   function startTimer() {
 48:     stopTimer();
 49:     timeLeft = QUESTION_TIME_LIMIT;
 50: 
 51:     timerId = setInterval(() => {
 52:       if (gameState !== 'playing') {
 53:         stopTimer();
 54:         return;
 55:       }
 56: 
 57:       timeLeft -= 1;
 58: 
 59:       if (timeLeft <= 0) {
 60:         handleTimeOut();
 61:       }
 62:     }, 1000);
 63:   }
 64: 
 65:   // Start the game for the first time when the Start button is pressed
 66:   async function startGame() {
 67:     correctCount = 0;
 68:     incorrectCount = 0;
 69:     remainingQuestions = [...questionsData];
 70:     currentQuestion = getRandomQuestion(remainingQuestions);
 71:     gameState = 'playing';
 72:     startTimer();
 73: 
 74:     await tick();
 75:     if (inputField) {
 76:       inputField.focus();
 77:     }
 78:   }
 79: 
 80:   // Evaluate the player's answer (both manual submit and timer expiration)
 81:   function evaluateAnswer(cleanedAnswer, isTimeout) {
 82:     stopTimer();
 83: 
 84:     const isCorrect =
 85:       cleanedAnswer !== '' &&
 86:       cleanedAnswer === currentQuestion.answer.trim();
 87: 
 88:     if (isCorrect) {
 89:       correctCount += 1;
 90:       remainingQuestions = remainingQuestions.filter(
 91:         (item) => item !== currentQuestion
 92:       );
 93: 
 94:       if (remainingQuestions.length === 0) {
 95:         gameState = 'won';
 96:         return;
 97:       }
 98: 
 99:       feedbackMessage = isTimeout
100:         ? "Time's up, but your answer was correct!"
101:         : 'Correct!';
102:       feedbackStatus = 'correct';
103:     } else {
104:       incorrectCount += 1;
105:       lives -= 1;
106: 
107:       if (lives <= 0) {
108:         lives = 0;
109:         gameState = 'lost';
110:         return;
111:       }
112: 
113:       if (isTimeout && cleanedAnswer === '') {
114:         feedbackMessage = `Time's up! No answer was entered for "${currentQuestion.question}".`;
115:       } else if (isTimeout) {
116:         feedbackMessage = `Time's up! "${currentQuestion.question}" is not ${cleanedAnswer}.`;
117:       } else {
118:         feedbackMessage = `Wrong! "${currentQuestion.question}" is not ${cleanedAnswer}.`;
119:       }
120:       feedbackStatus = 'wrong';
121:     }
122: 
123:     userAnswer = '';
124:     currentQuestion = getRandomQuestion(remainingQuestions);
125:     startTimer();
126: 
127:     if (inputField) {
128:       inputField.focus();
129:     }
130:   }
131: 
132:   // Check whatever is currently in the input box when the timer hits 0
133:   function handleTimeOut() {
134:     if (gameState !== 'playing') {
135:       return;
136:     }
137:     evaluateAnswer(userAnswer.trim(), true);
138:   }
139: 
140:   // Handle manual form submission
141:   function handleSubmit() {
142:     const cleanedAnswer = userAnswer.trim();
143: 
144:     if (cleanedAnswer === '' || gameState !== 'playing') {
145:       return;
146:     }
147: 
148:     evaluateAnswer(cleanedAnswer, false);
149:   }
150: 
151:   // Reset all fields and restart the timer for a fresh game
152:   async function restartGame() {
153:     lives = MAX_LIVES;
154:     correctCount = 0;
155:     incorrectCount = 0;
156:     remainingQuestions = [...questionsData];
157:     currentQuestion = getRandomQuestion(remainingQuestions);
158:     userAnswer = '';
159:     feedbackMessage = '';
160:     feedbackStatus = '';
161:     gameState = 'playing';
162:     startTimer();
163: 
164:     await tick();
165:     if (inputField) {
166:       inputField.focus();
167:     }
168:   }
169: 
170:   onDestroy(() => {
171:     stopTimer();
172:   });
